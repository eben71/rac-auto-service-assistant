# Safe demo defaults. No real credentials belong in this file.
AUTOQUOTES_PROVIDER=mock
AUTOQUOTES_VEHICLE_PROVIDER=mock
AUTOQUOTES_SERVICE_PROVIDER=mock

# Live registration lookup only. Keep these server-side.
AUTOQUOTES_BASE_URL=https://ractest.com.au
AUTOQUOTES_SUBSCRIPTION_KEY=
# Set this to the verified RAC API gateway subscription-key header name.
AUTOQUOTES_SUBSCRIPTION_KEY_HEADER=
AUTOQUOTES_TIMEOUT_MS=5000

# ASQ Auto Services Booking registration lookup. The API key remains server-only.
NEXT_PUBLIC_ASQ_BASE_URL=https://api-sit.ractest.com.au
NEXT_PUBLIC_ASQ_VEHICLE_ENDPOINT=asqvehicle/v1
ASQ_API_KEY=
ASQ_AUTH_SCOPE=
ASQ_MANAGED_IDENTITY_CLIENT_ID=
NEXT_PUBLIC_CORRELATION_ID_HEADER=Correlation-ID

# Fill the three slots in .env.local with actual authorised developer identities.
# Missing slots cannot sign in. No sample identities are invented.
DEMO_DEVELOPER_1_EMAIL=
DEMO_DEVELOPER_1_NAME=
DEMO_DEVELOPER_2_EMAIL=
DEMO_DEVELOPER_2_NAME=
DEMO_DEVELOPER_3_EMAIL=
DEMO_DEVELOPER_3_NAME=

# Fill only after approved specifications and access are provided.
AUTOQUOTES_AUTH_CONFIGURATION=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=
